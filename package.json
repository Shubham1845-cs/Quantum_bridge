{
  "name": "quantumbridge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "quantum-core-site",
    "quantum-core-site/landingpage",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=server",
    "dev:proxy": "npm run dev:proxy --workspace=server",
    "dev:dashboard": "npm run dev --workspace=quantum-core-site",
    "dev:web": "npm run dev --workspace=quantum-core-site/landingpage",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "framer-motion": "^12.38.0"
  }
}
